# Copy to `backend/.env` and adjust. NEVER commit the real `.env`.
# All values below are safe development defaults.

# development | production
APP_ENV=development

# Allowed browser origin(s) for CORS. Comma-separated for multiple.
FRONTEND_ORIGIN=http://localhost:3000

# Embedding backend: mock | deterministic | fasttext | sentence-transformers
# "mock" needs no model download and is used in tests/CI.
EMBEDDING_PROVIDER=mock

# Absolute path to a LOCAL FastText model file — required only when
# EMBEDDING_PROVIDER=fasttext. Download cc.ko.300.bin yourself; the server never
# downloads a model and model files are never committed.
# Install the loader first:  uv sync --extra fasttext
# Windows example: FASTTEXT_MODEL_PATH=C:/models/cc.ko.300.bin
# Linux/macOS example: FASTTEXT_MODEL_PATH=/opt/models/cc.ko.300.bin
FASTTEXT_MODEL_PATH=

# Model id — only used when EMBEDDING_PROVIDER=sentence-transformers (see docs/MODEL_EVALUATION.md).
MODEL_NAME=

# Absolute path to a UTF-8 vocabulary file, one word per line. Guess ranks are
# computed against this word set; leave empty and every `rank` stays null (which
# the API contract allows). The vocabulary is generated from a Wiktionary dump
# and never committed — see ml/scripts/extract_wiktionary_words.py.
# Windows example: VOCABULARY_PATH=C:/models/game_words.txt
# Linux/macOS example: VOCABULARY_PATH=/opt/models/game_words.txt
VOCABULARY_PATH=

# How many answers' vocabulary-wide similarity arrays to keep in memory.
# Roughly RANK_CACHE_SIZE * vocabulary_size * 8 bytes.
RANK_CACHE_SIZE=32

# Reserved for later phases (multiplayer / history). Leave blank for now.
DATABASE_URL=
REDIS_URL=
