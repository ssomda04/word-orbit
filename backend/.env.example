# Copy to `backend/.env` and adjust. NEVER commit the real `.env`.
# All values below are safe development defaults.

# development | production
APP_ENV=development

# Allowed browser origin(s) for CORS. Comma-separated for multiple.
FRONTEND_ORIGIN=http://localhost:3000

# Embedding backend: mock | deterministic | fasttext | sentence-transformers
# "mock" needs no model download and is used in tests/CI.
EMBEDDING_PROVIDER=mock

# Absolute path to a LOCAL FastText model file — required only when
# EMBEDDING_PROVIDER=fasttext. Download cc.ko.300.bin yourself; the server never
# downloads a model and model files are never committed.
# Install the loader first:  uv sync --extra fasttext
# Windows example: FASTTEXT_MODEL_PATH=C:/models/cc.ko.300.bin
# Linux/macOS example: FASTTEXT_MODEL_PATH=/opt/models/cc.ko.300.bin
FASTTEXT_MODEL_PATH=

# Model id — only used when EMBEDDING_PROVIDER=sentence-transformers (see docs/MODEL_EVALUATION.md).
MODEL_NAME=

# Absolute path to a UTF-8 vocabulary file, one word per line. Guess ranks are
# computed against this word set; leave empty and every `rank` stays null (which
# the API contract allows). The vocabulary is generated from a Wiktionary dump
# and never committed — see ml/scripts/extract_wiktionary_words.py.
# Windows example: VOCABULARY_PATH=C:/models/game_words.txt
# Linux/macOS example: VOCABULARY_PATH=/opt/models/game_words.txt
VOCABULARY_PATH=

# How many answers' vocabulary-wide similarity arrays to keep in memory.
# Roughly RANK_CACHE_SIZE * vocabulary_size * 8 bytes.
RANK_CACHE_SIZE=32

# Where a guess's similarity and rank come from: embedding | artifact
#   embedding - computed at request time from the live EMBEDDING_PROVIDER model.
#               This is the default and the historical behaviour; the three
#               variables above are the ones that matter, and the two below are
#               ignored.
#   artifact  - read from a root precomputed offline by the ML area. No model is
#               loaded: EMBEDDING_PROVIDER, FASTTEXT_MODEL_PATH and
#               VOCABULARY_PATH are all unused, and FastText need not even be
#               installed. Answers are drawn from the root's manifest rather than
#               from the placeholder word list, a guess outside the root's
#               vocabulary is rejected with 400 INVALID_WORD, and each answer's
#               arrays are loaded on first use and kept in a bounded cache.
SCORING_PROVIDER=embedding

# Absolute path to an artifact root — required only when
# SCORING_PROVIDER=artifact. The layout is docs/ARTIFACT_FORMAT.md. Artifact
# roots are data: they are produced by the ML area and never committed. The root
# is fully validated at startup, so a wrong path fails the server rather than the
# first guess.
# Windows example: ARTIFACT_ROOT=C:/models/contextle-artifacts
# Linux/macOS example: ARTIFACT_ROOT=/opt/models/contextle-artifacts
ARTIFACT_ROOT=

# How many answers' artifact arrays to keep in memory. Must be a positive
# integer. Roughly ARTIFACT_CACHE_SIZE * vocabulary_size * 6 bytes.
ARTIFACT_CACHE_SIZE=64

# Reserved for later phases (multiplayer / history). Leave blank for now.
DATABASE_URL=
REDIS_URL=
