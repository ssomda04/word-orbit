# Keep the build context small and reproducible.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Agent tooling runtime state. It is gitignored, but `COPY artifacts ./artifacts`
# would otherwise carry a stray `.omc/` written anywhere under the context into
# the image.
**/.omc/
.env
.env.*
!.env.example
tests/
README.md
.dockerignore
Dockerfile
