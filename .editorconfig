# EditorConfig — consistent formatting across editors and OSes.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python uses 4-space indentation (PEP 8 / Ruff default).
[*.py]
indent_size = 4

# Makefiles require real tabs.
[Makefile]
indent_style = tab

# Markdown: keep trailing whitespace (used for hard line breaks).
[*.md]
trim_trailing_whitespace = false
